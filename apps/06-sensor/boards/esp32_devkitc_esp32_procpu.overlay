/ {
    /* LED and buttons for the original ESP32 DevKitC. */
    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>; /* Onboard LED */
            label = "Status LED";
        };
    };

    buttons {
        compatible = "gpio-keys";
        button0: button_0 {
            gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* Onboard BOOT button */
            label = "Boot Button";
        };
        button1: button_1 {
            gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* External pin */
            label = "Hall Sensor";
        };
    };

    /* The app binds led0 and sw0; hal0 is not used by it. */
    aliases {
        led0 = &led0;
        sw0 = &button0;
        hal0 = &button1;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-names = "default";

    bme280: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};
