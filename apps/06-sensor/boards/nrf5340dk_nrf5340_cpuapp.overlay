/* boards/nrf5340dk_nrf5340_cpuapp.overlay */

/ {
    aliases {
        /* empty, in the device tree, these aliases were already assigned

            led0 = &led0;
            sw0 = &button0;

        */
    };
};

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    bme280: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};
