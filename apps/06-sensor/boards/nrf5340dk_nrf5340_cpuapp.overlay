/ {
    aliases {
        /* Empty: the board devicetree already sets led0 = &led0 and sw0 = &button0. */
    };
};

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    bme280: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};
