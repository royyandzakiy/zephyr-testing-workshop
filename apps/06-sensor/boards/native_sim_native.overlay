/* boards/native_sim.overlay */
/ {
    /* GPIO emulator for native_sim - must match what test_harness expects */
    emul_gpio: gpio_emul {
        compatible = "zephyr,gpio-emul";
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <32>;
        interrupt-controller;
        #interrupt-cells = <2>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    leds {
        compatible = "gpio-leds";
        test_led: led_0 {
            gpios = <&emul_gpio 10 GPIO_ACTIVE_HIGH>;
        };
    };

    buttons {
        compatible = "gpio-keys";
        test_button: btn_0 {
            gpios = <&emul_gpio 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            zephyr,code = <0x01>;  /* KEY_0 */
        };
    };

    aliases {
        led0 = &test_led;
        sw0 = &test_button;
    };
};
/* native_sim already ships an I2C emulation controller (i2c0, see
 * boards/native/native_sim/native_sim.dts), so all we add is the child node.
 * Same label and same address as the nrf5340dk and esp32 overlays, so
 * DT_NODELABEL(bme280) in src/sensors/bme280.c resolves identically on every
 * target -- which is the entire point.
 */
&i2c0 {
    status = "okay";

    bme280: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};
