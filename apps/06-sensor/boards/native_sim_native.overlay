/* native_sim already has an emulated I2C controller (i2c0), so only the BME280
 * node is added. Label and address match the board overlays, so
 * DT_NODELABEL(bme280) in src/sensors/bme280.c resolves on every target.
 */
&i2c0 {
    status = "okay";

    bme280: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};
