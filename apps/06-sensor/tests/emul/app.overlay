/* Test-only overlay: a BME280 on native_sim's emulated i2c0, under the same
 * node label as the board overlays, so src/sensors/bme280.c binds it unchanged.
 */

&i2c0 {
    status = "okay";

    bme280: bme280@77 {
        compatible = "bosch,bme280";
        reg = <0x77>;
        status = "okay";
    };
};
