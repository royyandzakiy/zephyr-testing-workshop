/* tests/shell_pytest/app.overlay */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    emul_gpio: gpio_emul {
        compatible = "zephyr,gpio-emul";
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <4>;
        interrupt-controller;
        #interrupt-cells = <2>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    emul_keys {
        compatible = "gpio-keys";
        emul_button_0: emul_button_0 {
            gpios = <&emul_gpio 0 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_0>;
        };
    };

    emul_leds {
        compatible = "gpio-leds";
        emul_led_0: emul_led_0 {
            gpios = <&emul_gpio 1 GPIO_ACTIVE_HIGH>;
        };
    };

    /* BOTH aliases have to move. Reroute sw0 alone and led0 falls through to
     * native_sim's own led_0 on &gpio0 -- a controller this build never
     * enables -- and the first toggle from the button callback takes the
     * process down with a SIGSEGV. */
    aliases {
        sw0 = &emul_button_0;
        led0 = &emul_led_0;
    };
};