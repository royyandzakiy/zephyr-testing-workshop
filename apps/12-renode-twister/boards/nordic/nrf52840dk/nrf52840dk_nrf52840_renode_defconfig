# Copy of Zephyr v4.4.0's nrf52840dk_nrf52840_defconfig. A defconfig cannot include
# another, so this copy must follow any change to the stock file.

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# enable uart driver
CONFIG_SERIAL=y

# enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
