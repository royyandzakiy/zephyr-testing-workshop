/* Test-only overlay: an emulated GPIO controller, LED and button, with led0
 * and sw0 pointed at them. src/blinky.c binds the aliases unchanged.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    emul_gpio: gpio_emul {
        compatible = "zephyr,gpio-emul";
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <4>;
        interrupt-controller;
        #interrupt-cells = <2>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    emul_leds {
        compatible = "gpio-leds";
        emul_led_0: emul_led_0 {
            gpios = <&emul_gpio 0 GPIO_ACTIVE_HIGH>;
        };
    };

    emul_keys {
        compatible = "gpio-keys";
        emul_button_0: emul_button_0 {
            gpios = <&emul_gpio 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            zephyr,code = <INPUT_KEY_0>;
        };
    };

    /* Both aliases move. Rerouting only one leaves its partner on native_sim's own
     * &gpio0, a controller never initialised, and the first access crashes with SIGSEGV. */
    aliases {
        led0 = &emul_led_0;
        sw0 = &emul_button_0;
    };
};
