/* tests/emul/app.overlay
 *
 * THE TEST-ONLY OVERLAY.
 *
 * A fake GPIO controller, a fake LED, a fake button -- and then led0/sw0
 * are pointed at them. src/blinky.c binds those two aliases and neither
 * knows nor cares that nothing here is real.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    emul_gpio: gpio_emul {
        compatible = "zephyr,gpio-emul";
        status = "okay";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <4>;
        interrupt-controller;
        #interrupt-cells = <2>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    emul_leds {
        compatible = "gpio-leds";
        emul_led_0: emul_led_0 {
            gpios = <&emul_gpio 0 GPIO_ACTIVE_HIGH>;
        };
    };

    emul_keys {
        compatible = "gpio-keys";
        emul_button_0: emul_button_0 {
            gpios = <&emul_gpio 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            zephyr,code = <INPUT_KEY_0>;
        };
    };

    aliases {
        led0 = &emul_led_0;
        sw0 = &emul_button_0;
    };
};
