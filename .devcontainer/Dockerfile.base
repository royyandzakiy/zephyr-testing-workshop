# Base image: everything needed to BUILD Zephyr, except the Zephyr SDK.
#
# Mirrors zephyrproject-rtos/docker-image's Dockerfile.base. Built ground-up from
# Ubuntu rather than from zephyrprojectrtos/zephyr-build (~32 GB, mostly
# toolchains and emulators this repo never uses).
#
# The Zephyr SDK and the Zephyr tree are not in any of these images -- they live
# in the shared volume at /workdir/zephyr-sdks, installed on first container
# start by setup-sdks.sh, so every project reusing this .devcontainer/ shares one
# download per machine.
#
# Chain:  Dockerfile.base -> Dockerfile.ci -> Dockerfile.devel   (see build.sh)
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# native_sim (and native_sim/native, which this repo builds) is a 32-BIT host
# binary, which drives two things here:
#   gcc-multilib/g++-multilib  pull in /lib32/libasan.so.* and /lib32/libubsan.so.*,
#                              which sanitizers_native-sim_ci.yml asserts exist
#   libsdl2-dev:i386           lets display/LVGL samples link; needs the i386 arch
RUN dpkg --add-architecture i386 \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-multilib \
    g++-multilib \
    cmake \
    ninja-build \
    make \
    gperf \
    ccache \
    device-tree-compiler \
    # static analysis, via -DZEPHYR_SCA_VARIANT=clang-tidy|sparse.
    # clang-tidy-18, not the `clang-tidy` metapackage: the metapackage does not
    # reliably leave a /usr/bin/clang-tidy under --no-install-recommends.
    clang-tidy-18 \
    sparse \
    gdb \
    gcovr \
    lcov \
    valgrind \
    libsdl2-dev \
    libsdl2-dev:i386 \
    python3 \
    python3-dev \
    python3-venv \
    python3-pip \
    python3-setuptools \
    python-is-python3 \
    ca-certificates \
    curl \
    wget \
    git \
    gnupg \
    openssh-client \
    file \
    jq \
    unzip \
    xz-utils \
    rsync \
    socat \
    srecord \
    sudo \
    locales \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 marks the system interpreter externally-managed (PEP 668), so a
# venv is required, not stylistic.
ENV VIRTUAL_ENV=/opt/python-venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}

RUN python3 -m venv ${VIRTUAL_ENV} \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir west

# One venv for all Zephyr versions. These pins barely move between minor
# releases; bump ZEPHYR_REQ_REF if a newer Zephyr needs something. Independent of
# versions.env. requirements-doc is excluded (sphinx, several hundred MB).
ARG ZEPHYR_REQ_REF=v4.2.2
RUN ZREQ="https://raw.githubusercontent.com/zephyrproject-rtos/zephyr/${ZEPHYR_REQ_REF}/scripts" \
    && pip install --no-cache-dir \
      -r "${ZREQ}/requirements-base.txt" \
      -r "${ZREQ}/requirements-build-test.txt" \
      -r "${ZREQ}/requirements-run-test.txt" \
      -r "${ZREQ}/requirements-extras.txt" \
      'esptool>=5.0.2'

RUN set -e; \
    ldconfig -p | grep -q "libasan.*lib32"  || { echo "MISSING 32-bit libasan"; exit 1; }; \
    ldconfig -p | grep -q "libubsan.*lib32" || { echo "MISSING 32-bit libubsan"; exit 1; }; \
    test -f /usr/lib/i386-linux-gnu/libSDL2.so || { echo "MISSING 32-bit libSDL2"; exit 1; }; \
    for t in clang-tidy sparse cgcc valgrind; do \
        command -v "$t" >/dev/null || { echo "MISSING $t"; exit 1; }; \
    done; \
    west --version && cmake --version | head -1 && \
    python3 -c "import pytest; print('pytest', pytest.__version__)"
