{
  "name": "Zephyr Development (build from source)",
  // Same as ../devcontainer.json but builds the images locally instead of
  // pulling from GHCR. Use this when changing a Dockerfile; use the other one
  // for normal work and for attendees.
  //
  // Only base + devel are built -- Dockerfile.ci exists for GitHub Actions and
  // bakes in an SDK development does not need. `WITH_CI=1 bash
  // .devcontainer/build.sh` builds it if you want to test that image.
  //
  // Spelled out inline rather than calling build.sh: on Windows `bash` usually
  // resolves to the WSL shim, so the container would not start if WSL is broken.
  "image": "zephyr-workshop-devel:local",
  "initializeCommand": "docker build -f .devcontainer/Dockerfile.base -t zephyr-workshop-base:local .devcontainer && docker build -f .devcontainer/Dockerfile.devel --build-arg BASE_IMAGE=zephyr-workshop-base:local -t zephyr-workshop-devel:local .devcontainer",
  // Must match versions.env, which this file cannot read; setup-sdks.sh fails
  // loudly if they disagree. Needed here because the extension host does not see
  // what `use-vanilla` exports in interactive shells.
  "containerEnv": {
    "RUNNER_ALLOW_RUNASROOT": "1",
    "ZEPHYR_BASE": "/workdir/zephyr-sdks/v4.4.2/zephyr",
    "ZEPHYR_SDK_INSTALL_DIR": "/workdir/zephyr-sdks/toolchains/zephyr-sdk-1.0.1",
    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr"
  },
  "containerUser": "root",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--privileged"
  ],
  // SDK volumes have no project prefix on purpose: every project copying this
  // .devcontainer/ shares one download. The runner volume holds one registration,
  // so it must be per-project.
  "mounts": [
    "source=zephyr-sdks-cache,target=/workdir/zephyr-sdks,type=volume",
    "source=ncs-sdks-cache,target=/workdir/ncs-sdks,type=volume",
    "source=${localWorkspaceFolderBasename}-actions-runner,target=/actions-runner,type=volume",
    "source=/dev,target=/dev,type=bind,bind-propagation=rslave"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        // "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "nordic-semiconductor.nrf-connect",
        "thecreativedodo.usbip-connect"
      ],
      "settings": {
        "nrf-connect.toolchainManager.installDirectory": "/workdir/ncs-sdks"
      }
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postStartCommand": "/bin/bash .devcontainer/setup-sdks.sh"
}