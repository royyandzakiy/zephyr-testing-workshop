# Which Zephyr and Zephyr SDK this project wants. Installed into the shared
# volume /workdir/zephyr-sdks on first use.
#
# The only file to edit when copying .devcontainer/ into a new project -- along
# with the matching paths in devcontainer.json, which cannot read an env file.
# setup-sdks.sh fails loudly if the two disagree.
#
# Sourced by setup-sdks.sh and fetch-zephyr.sh. Plain KEY=value only.

ZEPHYR_VERSION=v4.2.2
ZSDK_VERSION=0.17.0

# arm: nrf5340dk, nucleo_g474re. x86_64: native_sim/native/64. xtensa: esp32(s3).
# Trimming this in another project costs nothing -- `setup.sh -t` is incremental,
# so the shared volume accumulates the union across projects.
ZSDK_TOOLCHAINS="arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf"
