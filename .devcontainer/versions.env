# Which Zephyr and Zephyr SDK this project wants.
#
# The only file to edit when copying .devcontainer/ into a new project -- with
# the matching paths in devcontainer.json, which cannot read an env file.
# setup-sdks.sh fails loudly if the two disagree.
#
# Installed into the shared volume (/workdir/zephyr-sdks) on first use, so every
# project naming the same versions starts with no download.
#
# Sourced by setup-sdks.sh and fetch-zephyr.sh. Plain KEY=value only.

ZEPHYR_VERSION=v4.2.2
ZSDK_VERSION=0.17.0

# Only the toolchains this project builds for: nrf5340dk/nucleo_g474re (arm),
# native_sim/native/64 (x86_64), esp32 and esp32s3 (xtensa).
#
# Trimming this list in another project skips nothing -- `setup.sh -t` is
# incremental, so the shared volume accumulates the union across projects and
# each toolchain is downloaded at most once.
ZSDK_TOOLCHAINS="arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf"
