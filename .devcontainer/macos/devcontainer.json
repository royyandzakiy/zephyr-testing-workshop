{
  "name": "Zephyr & NCS Build Environment (macOS, no USB)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "options": ["--platform=linux/amd64"]
  },
  "containerEnv": {
    "RUNNER_ALLOW_RUNASROOT": "1",
    // See the comment in ../devcontainer.json -- the extension host does not see
    // what `use-vanilla` exports in interactive shells.
    "ZEPHYR_SDK_INSTALL_DIR": "/workdir/zephyr-sdks/toolchains/zephyr-sdk-0.17.0"
  },
  "containerUser": "root",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--privileged"
  ],
  "mounts": [
    "source=zephyr-sdks-cache,target=/workdir/zephyr-sdks,type=volume",
    "source=ncs-sdks-cache,target=/workdir/ncs-sdks,type=volume",
    "source=actions-runner-state,target=/actions-runner,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        // "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "nordic-semiconductor.nrf-connect"
      ],
      "settings": {
        // Where the extension's bundled nrfutil looks for NCS toolchains. See
        // ../devcontainer.json and .devcontainer/register-sdks.sh.
        "nrf-connect.toolchainManager.installDirectory": "/workdir/ncs-sdks"
      }
    }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postStartCommand": "/bin/bash .devcontainer/setup-sdks.sh"
}