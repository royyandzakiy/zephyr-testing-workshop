# CI image: base plus the Zephyr SDK and the Zephyr tree, BAKED IN.
#
# Consumed only by .github/workflows/* as their `container:` image. GitHub-hosted
# runners have no persistent volume, so unlike the devel image this one cannot
# use /workdir -- the pair goes into /opt/zephyr-sdks, the second store that
# use-vanilla already searches.
#
# Deliberately has no nrfutil, J-Link or Actions runner: the jobs that flash
# hardware run `runs-on: [self-hosted, linux]` with no container at all, on a
# runner hosted inside the devel container, which is where those tools live.
ARG BASE_IMAGE=zephyr-workshop-base:local
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Must match .devcontainer/versions.env. build.sh and the publish workflow pass
# these through so there is one source of truth.
ARG ZEPHYR_VERSION=v4.4.2
ARG ZSDK_VERSION=1.0.1
ARG ZSDK_TOOLCHAINS="arm-zephyr-eabi x86_64-zephyr-elf xtensa-espressif_esp32_zephyr-elf xtensa-espressif_esp32s3_zephyr-elf"
ARG ZEPHYR_BLOBS="hal_espressif"

ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdks/toolchains/zephyr-sdk-${ZSDK_VERSION}
ENV ZEPHYR_BASE=/opt/zephyr-sdks/${ZEPHYR_VERSION}/zephyr
ENV ZEPHYR_TOOLCHAIN_VARIANT=zephyr

RUN mkdir -p /opt/zephyr-sdks/toolchains \
    && cd /opt/zephyr-sdks/toolchains \
    && wget -qO- "https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${ZSDK_VERSION}/zephyr-sdk-${ZSDK_VERSION}_linux-x86_64_minimal.tar.xz" | tar -xJ \
    && cd "zephyr-sdk-${ZSDK_VERSION}" \
    && targs=() \
    && for t in ${ZSDK_TOOLCHAINS}; do targs+=(-t "$t"); done \
    && ./setup.sh -h -c "${targs[@]}"

RUN mkdir -p "/opt/zephyr-sdks/${ZEPHYR_VERSION}" \
    && git clone --depth 1 --branch "${ZEPHYR_VERSION}" \
       https://github.com/zephyrproject-rtos/zephyr.git "${ZEPHYR_BASE}" \
    && cd "/opt/zephyr-sdks/${ZEPHYR_VERSION}" \
    && west init -l "${ZEPHYR_BASE}" \
    && west update --narrow -o=--depth=1 \
    && west zephyr-export \
    && for m in ${ZEPHYR_BLOBS}; do west blobs fetch "$m"; done

# Fail the build here rather than in someone's CI run.
RUN set -e; \
    test -f "${ZEPHYR_BASE}/VERSION" || { echo "MISSING Zephyr checkout"; exit 1; }; \
    test -d "/opt/zephyr-sdks/${ZEPHYR_VERSION}/modules/hal/espressif" || { echo "west update incomplete"; exit 1; }; \
    test -f "${ZEPHYR_SDK_INSTALL_DIR}/cmake/Zephyr-sdkConfig.cmake" || { echo "MISSING Zephyr-sdkConfig.cmake"; exit 1; }; \
    for t in ${ZSDK_TOOLCHAINS}; do \
        [ -d "${ZEPHYR_SDK_INSTALL_DIR}/$t" ] || [ -d "${ZEPHYR_SDK_INSTALL_DIR}/gnu/$t" ] \
            || { echo "MISSING toolchain $t"; exit 1; }; \
    done; \
    ls "${HOME}/.cmake/packages/Zephyr-sdk/"* >/dev/null || { echo "MISSING CMake registry entry"; exit 1; }

WORKDIR /workspaces
