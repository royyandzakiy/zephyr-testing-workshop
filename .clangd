# clangd configuration.
# .clangd - applies repo-wide.
#
# No CompilationDatabase key on purpose. clangd discovers
# apps/<app>/build/compile_commands.json by walking up from the source file.
# Just build the app once and the language server is correct:
#
#   cd apps/01-blinky && west build -b native_sim/native
#
# "file not found" on <zephyr/...> means you haven't built that app yet.

CompileFlags:
  Remove:
    - -Werror
    - -pedantic
    - -fno-reorder-functions
    - -fno-defer-pop
    - -fno-freestanding
    - --param=min-pagesize=*
    - -mfp16-format=*
    - -fno-printf-return-value
    - -mlongcalls
    - -fstrict-volatile-bitfields
    # Add these to handle Xtensa/ESP32 specific flags
    - -mtext-section-literals
    - -mlong-calls
    - -fno-builtin
    - -g*
    - -O*
    - -ffunction-sections
    - -fdata-sections
    - -march=*
    - -mtune=*
    - -mabi=*
    - -mcmodel=*

Diagnostics:
  # Zephyr headers pull in transitively-used symbols by design.
  UnusedIncludes: None
  MissingIncludes: None

Index:
  Background: Build
  StandardLibrary: true
